# Git files
.git/
.gitignore

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build artifacts
*.egg-info/
dist/
build/

# Documentation
*.md
docs/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Docker files (prevent recursive copy)
Dockerfile*
docker-compose*
.dockerignore

# Large data files (mounted as volumes instead)
*.npz
*.npy
data/
simulation/output/
simulation/raw/
# ... except the land mask: the dataset converter needs it inside the image
!simulation/land_mask_025deg.npz

# Example pieces and previews (about 130 MB of MP3/PNG/GIF, not used by the server)
music/examples/
music/output/
simulation/preview/

# Cache directory (will be created at runtime)
backend/cache/

# Sounds are downloaded inside the image build (Dockerfile, stage "sounds"), so local copies stay out:
# the image is the same whoever builds it, and the build context stays small
soundfonts/*.sf2
soundfonts/_gugs/
soundfonts/vsco/
