# Git files
.git/
.gitignore

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build artifacts
*.egg-info/
dist/
build/

# Documentation
*.md
docs/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Docker files (prevent recursive copy)
Dockerfile*
docker-compose*
.dockerignore

# Large data files (mounted as volumes instead)
*.npz
*.npy
data/
simulation/output/

# Cache directory (will be created at runtime)
backend/cache/

# Soundfonts are large - consider a separate image or download
# Uncomment if soundfonts should not be in the image:
# soundfonts/
